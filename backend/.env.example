PORT=3001
# Render PostgreSQL: use a URL de conexão fornecida pelo provedor.
DATABASE_URL=
# Ative somente se seu provedor exigir SSL e a cadeia de certificados for tratada adequadamente.
DB_SSL=false
# Alternativa para desenvolvimento local sem DATABASE_URL:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=books_db
